<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon background. Solid on purpose: the launcher masks this to a circle, a squircle or
    a rounded square depending on the device, and any shape or gradient in here has to survive all
    three.

    BrandTealDeep rather than a light field, because the orange foreground form needs a dark
    background to stay legible. BrandOrange measures 1.6:1 against IconBoxBg and 2.05:1 against
    AppBackground — at 48dp that is a smudge, not a shape. A dark tile also holds its edge against
    a light wallpaper, where a near-white icon reads as an empty slot.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#1E4C57"
        android:pathData="M0,0h108v108h-108z" />
</vector>
