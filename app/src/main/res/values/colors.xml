<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Tint behind the status-bar notification icon. Same value as BrandTeal in Color.kt;
         duplicated because a notification is drawn by the system, which cannot read Compose. -->
    <color name="notification_accent">#FF2E6E7E</color>

    <!-- Splash window colours. Same values as BrandTealDeep and AppBackground in ui/theme/Color.kt,
         duplicated for the same reason notification_accent above is: the splash is drawn by the
         window manager before any Compose code runs, and it cannot read Kotlin. Changing one
         without the other shows up as a colour step between the splash and the first frame. -->
    <color name="brand_teal_deep">#FF1E4C57</color>
    <color name="app_background">#FFF6F7F9</color>
</resources>