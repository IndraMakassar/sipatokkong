<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY manifest. Adds a separate launcher icon ("SIPATOKKONG Preview") that opens the
  parent dashboard directly, without touching the real login flow. Merged only into debug builds.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".DevPreviewActivity"
            android:exported="true"
            android:label="SIPATOKKONG Preview"
            android:theme="@style/Theme.Sipatokkong">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
